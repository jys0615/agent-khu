# Database
POSTGRES_DB=agent_khu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/agent_khu

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# Groq (SLM Layer 3 fallback — Llama 3.1 8B, 무료)
# 발급: console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Ollama (SLM Layer 2 — 로컬, 완전 무료)
# Docker Compose 사용 시 자동 설정. 미설정 시 Ollama 비활성화
# 모델 설치: docker exec agent-khu-ollama ollama pull qwen2.5:1.5b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Server
HOST=0.0.0.0
PORT=8000

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin (캐시 전체 삭제 등 관리자 API 보호)
# 운영 환경에서 반드시 강력한 랜덤 문자열로 설정하세요
# 미설정 시 개발 편의를 위해 인증을 건너뜁니다 (보안 경고 로그 출력)
ADMIN_SECRET_KEY=change-this-to-a-strong-random-secret
